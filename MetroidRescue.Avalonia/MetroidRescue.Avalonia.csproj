<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MetroidRescue</AssemblyName>
    <RootNamespace>MetroidRescue.Avalonia</RootNamespace>
    <Version>0.2.1</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MetroidRescue\CommandRunner.cs" Link="Core\CommandRunner.cs" />
    <Compile Include="..\MetroidRescue\FastbootService.cs" Link="Core\FastbootService.cs" />
    <Compile Include="..\MetroidRescue\FirmwareService.cs" Link="Core\FirmwareService.cs" />
    <Compile Include="..\MetroidRescue\RecoveryMonitor.cs" Link="Core\RecoveryMonitor.cs" />
    <Compile Include="..\MetroidRescue\RescueJournal.cs" Link="Core\RescueJournal.cs" />
    <Compile Include="..\MetroidRescue\SupportBundle.cs" Link="Core\SupportBundle.cs" />
    <Compile Include="..\MetroidRescue\ToolPaths.cs" Link="Core\ToolPaths.cs" />
    <Compile Include="..\MetroidRescue\FirmwareCatalogService.cs" Link="Core\FirmwareCatalogService.cs" />
    <Compile Include="..\MetroidRescue\ProvenanceService.cs" Link="Core\ProvenanceService.cs" />
    <Compile Include="..\MetroidRescue\PreflightService.cs" Link="Core\PreflightService.cs" />
    <Compile Include="..\MetroidRescue\RecoveryReportService.cs" Link="Core\RecoveryReportService.cs" />
    <Compile Include="..\MetroidRescue\ConservativeRecoveryPlan.cs" Link="Core\ConservativeRecoveryPlan.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="Tools\win-x64\adb.exe;Tools\win-x64\fastboot.exe;Tools\win-x64\AdbWinApi.dll;Tools\win-x64\AdbWinUsbApi.dll;Tools\win-x64\payload-dumper-go.exe;Tools\windows-driver\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Content Include="Tools\linux-x64\adb;Tools\linux-x64\fastboot;Tools\linux-x64\payload-dumper-go" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
